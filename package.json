{
  "name": "hire-flow-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "npx prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "promote": "tsx scripts/promote-super-admin.ts",
    "demote": "tsx scripts/demote-super-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cross-env E2E_DEV=1 playwright test",
    "test:e2e:ui": "cross-env E2E_DEV=1 playwright test --ui",
    "test:e2e:build": "cross-env E2E_PROD=1 playwright test",
    "test:e2e:build:ui": "cross-env E2E_PROD=1 playwright test --ui",
    "test:contract": "vitest run --project contract",
    "test:perf": "vitest run --project perf",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
