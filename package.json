    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.18.0",
    "mammoth": "^1.12.0",
    "motion": "^12.40.0",
    "ms": "^2.1.3",
    "next": "16.2.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.5.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
